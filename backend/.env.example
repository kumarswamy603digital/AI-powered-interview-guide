# Copy to .env and adjust. Every value below has a working default except
# SECRET_KEY, which must be changed before deploying.

# --- General ---------------------------------------------------------------
ENVIRONMENT=local

# --- Database --------------------------------------------------------------
# There are no migrations: if you add columns, recreate this database.
DATABASE_URL=sqlite:///./app.db

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ------------------------------------------------------------------
# JSON list of allowed origins. Empty falls back to localhost dev origins
# when ENVIRONMENT=local.
# BACKEND_CORS_ORIGINS=["https://your-frontend.example.com"]

# --- Resume uploads --------------------------------------------------------
RESUME_UPLOAD_DIR=uploads/resumes
RESUME_MAX_SIZE_MB=10

# --- Gemini (optional) -----------------------------------------------------
# Without a key, interview questions come from a built-in bank and reports use
# deterministic placeholder scores. Resume parsing, skill matching and candidate
# ranking never require a key.
# GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-1.5-pro
